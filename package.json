{
  "name": "samyak-workspace",
  "version": "0.0.0",
  "scripts": {
    "dev:brc": "concurrently -k -n shell,brc -c auto \"npm:start:shell\" \"npm:start:brc\"",
    "dev:iod": "concurrently -k -n shell,iod -c auto \"npm:start:shell\" \"npm:start:iod\"",
    "dev:csd": "concurrently -k -n shell,csd -c auto \"npm:start:shell\" \"npm:start:csd\"",
    "dev:crc": "concurrently -k -n shell,crc -c auto \"npm:start:shell\" \"npm:start:crc\"",
    "dev:rmc": "concurrently -k -n shell,rmc -c auto \"npm:start:shell\" \"npm:start:rmc\"",
    "dev:rbp": "concurrently -k -n shell,rbp -c auto \"npm:start:shell\" \"npm:start:rbp\"",
    "start": "npm run start:all",
    "start:all": "concurrently -k -n shell,brc,iod,csd,crc,rmc,rbp -c auto \"npm:start:shell\" \"npm:start:brc\" \"npm:start:iod\" \"npm:start:csd\" \"npm:start:crc\" \"npm:start:rmc\" \"npm:start:rbp\"",
    "start:shell": "ng serve shell",
    "start:brc": "ng serve bank-registration-cell",
    "start:iod": "ng serve insurance-operation-department",
    "start:csd": "ng serve claim-settlement-department",
    "start:crc": "ng serve complaint-redressal-cell",
    "start:rmc": "ng serve recovery-management-cell",
    "start:rbp": "ng serve risk-based-premium",
    "build:all": "npm run build:shell && npm run build:brc && npm run build:iod && npm run build:csd && npm run build:crc && npm run build:rmc && npm run build:rbp",
    "build:shell": "ng build shell",
    "build:brc": "ng build bank-registration-cell",
    "build:iod": "ng build insurance-operation-department",
    "build:csd": "ng build claim-settlement-department",
    "build:crc": "ng build complaint-redressal-cell",
    "build:rmc": "ng build recovery-management-cell",
    "build:rbp": "ng build risk-based-premium",
    "test": "ng test shared-services --watch=false",
    "test:all": "ng test shared-services --watch=false && ng test shared-ui --watch=false && ng test shell --watch=false && ng test bank-registration-cell --watch=false && ng test insurance-operation-department --watch=false && ng test claim-settlement-department --watch=false && ng test complaint-redressal-cell --watch=false && ng test recovery-management-cell --watch=false && ng test risk-based-premium --watch=false",
    "add-remote": "node scripts/add-remote.mjs",
    "use-manifest": "node scripts/use-manifest.mjs",
    "ng": "ng"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^3.0.1",
    "@softarc/native-federation-node": "^3.3.4",
    "es-module-shims": "^1.5.12",
    "pdfjs-dist": "^6.4.299",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^21.2.6",
    "@angular-devkit/build-angular": "^21.2.25",
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
